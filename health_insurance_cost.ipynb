     ]
    }
   ],
   "source": [
    "lr = LinearRegression()\n",
    "lr.fit(X_train, y_train)\n",
    "results['Linear Regression'] = evaluate_model(lr, X_train, y_train, X_test, y_test)\n",
    "print(\"Linear Regression Results:\", results['Linear Regression'])"
   ]
  },
  {
